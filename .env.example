# Copie ce fichier en .env.local et remplis les valeurs (jamais commité)

# Supabase (même projet que l'app Pimp It) — clé anon, pas de service role : le Hub s'appuie sur
# Supabase Auth + RLS existante (is_admin()), exactement comme l'app mobile/web.
NEXT_PUBLIC_SUPABASE_URL=https://vctrmckziomiutstndmn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shopify (mêmes identifiants que Shopify Pimp IT/admin/.env) — lecture seule pour l'instant.
SHOPIFY_STORE=pimpmycrocs.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Airtable (mêmes identifiants que Shopify Pimp IT/admin/.env) — lecture seule pour l'instant.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Boxtal API v3 (étiquettes d'expédition) — compte de PRODUCTION : toute commande créée via ces
# identifiants est réelle et facturée, ce ne sont pas des clés de test.
BOXTAL_ACCESS_KEY=
BOXTAL_SECRET_KEY=
